# Normalize text files automatically
* text=auto

# Source and config files should stay LF across platforms
*.dart text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.swift text eol=lf
*.xcconfig text eol=lf
*.plist text eol=lf

# Script files with platform-specific endings
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets should never be modified by line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.jar binary
*.keystore binary
